{%- comment -%}
PROTOTYPE variant B2: poster shelf, refined from maintainer feedback on B.
Six equal posters; progress bar with time left printed across it; NEW / NEXT tags for
unstarted items; overflow as a text line; section icons; Airing in two columns past four.
Past six items, the rest are listed as text in up to three columns (12 items at most).
{%- endcomment -%}
{% assign icon_style = "generic" %}
{% assign cw = continue_watching.items %}{% assign cw_n = cw | size %}
{% assign air = airing.items %}{% assign air_n = air | size %}
{% assign rel = releasing_today.items %}{% assign rel_n = rel | size %}
{% assign err_n = errors | size %}

{%- capture icon_tv -%}<svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;vertical-align:-0.15em"><path d="M8 2.5l4 4 4-4"/><rect x="2.5" y="6.5" width="19" height="14" rx="2.5"/></svg>{%- endcapture -%}
{%- capture icon_film -%}<svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" style="flex-shrink:0;vertical-align:-0.15em"><rect x="3" y="2.5" width="18" height="19" rx="2"/><path d="M7.5 2.5v19M16.5 2.5v19M3 8h4.5M3 16h4.5M16.5 8H21M16.5 16H21"/></svg>{%- endcapture -%}
{%- capture icon_sonarr -%}<svg viewBox="0 0 24 24" width="1.15em" height="1.15em" fill="none" stroke="currentColor" stroke-width="2.4" style="flex-shrink:0;vertical-align:-0.2em"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/><path d="M12 2.5v5M12 16.5v5M2.5 12h5M16.5 12h5"/></svg>{%- endcapture -%}
{%- capture icon_radarr -%}<svg viewBox="0 0 24 24" width="1.15em" height="1.15em" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" style="flex-shrink:0;vertical-align:-0.2em"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="5"/><path d="M12 12l6.5-6.5"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>{%- endcapture -%}
{%- capture icon_queue -%}<svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" style="flex-shrink:0;vertical-align:-0.15em"><rect x="3" y="9" width="18" height="12" rx="2"/><path d="M5.5 5.5h13M8 2.5h8"/></svg>{%- endcapture -%}
{% if icon_style == "arr" %}{% assign icon_airing = icon_sonarr %}{% assign icon_releasing = icon_radarr %}{% else %}{% assign icon_airing = icon_tv %}{% assign icon_releasing = icon_film %}{% endif %}

<style>
  /* Use the framework's own faces so custom text matches the title bar and labels. */
  .wtw-name, .wtw-row .t, .wtw-head, .wtw-progress .txt, .wtw-tag { font-family: var(--title-font-family); }
  .wtw-sub, .wtw-row .m, .wtw-more { font-family: var(--description-font-family); }
  .wtw-shelf { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .wtw-poster { position: relative; aspect-ratio: 2 / 3; border: 3px solid #000; border-radius: 8px; overflow: hidden; background: #fff; }
  .wtw-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wtw-poster .wtw-fallback { height: 100%; display: flex; align-items: center; justify-content: center; padding: 10px; text-align: center; }
  .wtw-tag { position: absolute; top: 0; left: 0; background: #000; color: #fff; font-weight: 700; font-size: 15px; letter-spacing: .06em; padding: 3px 9px 4px; border-bottom-right-radius: 7px; }
  /* One element: the fill is the progress, the text is time left; difference blending keeps it legible on both halves. */
  .wtw-progress { position: absolute; left: 6px; right: 6px; bottom: 6px; height: 30px; background: #fff; border: 3px solid #000; border-radius: 6px; overflow: hidden; }
  .wtw-progress .fill { position: absolute; inset: 0 auto 0 0; background: #000; }
  .wtw-progress .txt { position: relative; display: flex; height: 100%; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; color: #fff; mix-blend-mode: difference; white-space: nowrap; }
  .wtw-cap { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; min-width: 0; }
  .wtw-name { font-weight: 700; line-height: 1.12; display: flex; gap: 6px; align-items: flex-start; overflow-wrap: anywhere; }
  .wtw-sub { font-size: 18px; line-height: 1.2; }
  .wtw-more { display: flex; gap: 10px; align-items: baseline; border-top: 3px solid #000; padding: 8px 2px 0; white-space: nowrap; overflow: hidden; font-size: 17px; }
  .wtw-band { display: flex; gap: 32px; flex: 1; min-height: 0; border-top: 4px solid #000; padding-top: 14px; }
  .wtw-more + .wtw-band { border-top-width: 0; padding-top: 4px; }
  .wtw-head { display: inline-flex; gap: 10px; align-items: center; font-size: 22px; font-weight: 700; margin-bottom: 6px; background: #000; color: #fff; border-radius: 9px; padding: 3px 14px 4px 10px; }
  .wtw-head .label { background: #fff; color: #000; }
  /* Row posters replace the grabbed dots; a corner check marks items already downloaded. */
  .wtw-rowposter img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wtw-rowposter .ok { position: absolute; right: 0; bottom: 0; width: 20px; height: 20px; background: #000; color: #fff; border-top-left-radius: 6px; display: flex; align-items: center; justify-content: center; }
  .wtw-over { border-top: 3px solid #000; padding-top: 8px; display: flex; flex-direction: column; gap: 2px; }
  .wtw-over-item { display: flex; gap: 12px; min-width: 0; align-items: center; }
  .wtw-over-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  /* 1-2 extra: one line each, spread evenly across the width */
  .wtw-over--row .wtw-over-grid { display: flex; justify-content: space-evenly; gap: 32px; }
  .wtw-over--row .wtw-over-txt { flex-direction: row; align-items: baseline; gap: 14px; }
  .wtw-over--row .wtw-name { font-size: 24px; }
  .wtw-over--row .wtw-sub { font-size: 21px; white-space: nowrap; }
  /* 3-4 extra: two columns, small poster beside larger text */
  /* 3-6 extra: two columns; small poster, then title and details on one line, text about 3/4 of the poster's height */
  .wtw-over--thumbs .wtw-over-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 44px; padding: 0 12px; }
  .wtw-over--thumbs .wtw-over-txt { flex-direction: row; align-items: baseline; gap: 14px; min-width: 0; }
  .wtw-over--thumbs .wtw-name { font-size: 26px; white-space: nowrap; }
  .wtw-over--thumbs .wtw-sub { font-size: 21px; white-space: nowrap; }
  .wtw-over + .wtw-band { border-top-width: 4px; padding-top: 12px; }
  .wtw-head + .wtw-sub { vertical-align: middle; }
  /* With the "Also waiting" list showing, crop posters a little shorter to leave room below. */
  .wtw-shelf--tight .wtw-poster { aspect-ratio: 3 / 4; }
  .wtw-shelf--tight .wtw-poster img { object-position: top; }
  /* With "Also waiting" showing, tighten the lower band so it still fits. */
  .wtw-over--thumbs .wtw-over-grid { row-gap: 4px; }
  .wtw-milestone { display: table; margin-top: 3px; background: #000; color: #fff; font-size: 14px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 1px 8px 2px; border-radius: 5px; }
  .wtw-over-head { display: flex; align-items: center; gap: 14px; }
  .wtw-over-head .wtw-head { margin-bottom: 0; }
  /* Lower band: rows share whatever height is left, and each row sizes its poster and text from its own height. */
  .wtw-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .wtw-list { flex: 1; min-height: 0; display: grid; column-gap: 28px; margin-top: 6px; }
  .wtw-row { container-type: size; min-height: 0; min-width: 0; display: flex; gap: 12px; align-items: center; border-bottom: 2px solid #bbb; padding: 3px 0; }
  .wtw-rowposter { position: relative; flex-shrink: 0; height: 88cqh; max-height: 120px; aspect-ratio: 2 / 3; border: 3px solid #000; border-radius: 5px; overflow: hidden; }
  .wtw-row .t { font-weight: 700; flex: 1; min-width: 0; line-height: 1.12; font-size: clamp(17px, min(30cqh, 6.4cqw), 34px); overflow-wrap: anywhere; }
  .wtw-row .t--long { font-size: clamp(15px, min(22cqh, 4.6cqw), 24px); }
  .wtw-row .m { white-space: nowrap; text-align: right; line-height: 1.2; font-size: clamp(15px, min(21cqh, 4.4cqw), 24px); }
  .wtw-row .m2 { display: block; font-family: var(--description-font-family); font-weight: 400; margin-top: 2px; font-size: clamp(15px, min(21cqh, 4.4cqw), 24px); }
  .wtw-milestone { font-size: clamp(12px, min(15cqh, 3.2cqw), 17px) !important; white-space: nowrap; }
</style>

<div class="view view--full">
<div class="layout layout--col" style="align-items:stretch;justify-content:flex-start;gap:14px">

{% if err_n > 0 %}
<div style="display:flex;gap:12px">{% for e in errors %}<span class="label label--inverted">{{ e.source | capitalize }} down since {{ e.since | date: "%-I:%M %p" }} · showing its last data</span>{% endfor %}</div>
{% endif %}

{% if cw_n == 0 and air_n == 0 and rel_n == 0 %}
<div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px">
  <span class="value value--xxlarge">Nothing waiting</span>
  <span class="description description--large">No shows in progress, nothing airing, nothing releasing today.</span>
</div>
{% else %}

{% if cw_n > 0 %}
<div class="wtw-shelf{% if cw_n > 6 %} wtw-shelf--tight{% endif %}">
  {% for i in cw limit:6 %}
  {% assign tlen = i.title | size %}
  {% if tlen > 28 %}{% assign fs = 15 %}{% elsif tlen > 18 %}{% assign fs = 17 %}{% else %}{% assign fs = 20 %}{% endif %}
  <div style="min-width:0">
    <div class="wtw-poster">
      {% if i.poster %}<img src="{{ i.poster }}" alt="">{% else %}<div class="wtw-fallback"><span class="title title--small">{{ i.title }}</span></div>{% endif %}
      {% if i.state == "in_progress" and i.progress %}
        <div class="wtw-progress"><div class="fill" style="width:{{ i.progress }}%"></div>
          <div class="txt">{% if i.remaining_min >= 60 %}{{ i.remaining_min | divided_by: 60 }}h {{ i.remaining_min | modulo: 60 }}m{% else %}{{ i.remaining_min }}m{% endif %} left</div></div>
      {% elsif i.state == "new" %}<span class="wtw-tag">NEW</span>
      {% else %}<span class="wtw-tag">NEXT</span>{% endif %}
    </div>
    <div class="wtw-cap">
      <span class="wtw-name" style="font-size:{{ fs }}px">{% if i.kind == "movie" %}{{ icon_film }}{% else %}{{ icon_tv }}{% endif %}<span>{{ i.title }}</span></span>
      <span class="wtw-sub">{% if i.episode %}S{{ i.episode.season }}E{{ i.episode.number }} · {% endif %}{% assign m = i.duration_min %}{% if m >= 60 %}{{ m | divided_by: 60 }}h {{ m | modulo: 60 }}m{% else %}{{ m }}m{% endif %}</span>
    </div>
  </div>
  {% endfor %}
</div>
{% if cw_n > 6 %}
{% assign extra = cw_n | minus: 6 %}{% assign rest = continue_watching.total | minus: cw_n %}
{% if extra <= 2 %}{% assign omode = "row" %}{% else %}{% assign omode = "thumbs" %}{% endif %}
<div class="wtw-over wtw-over--{{ omode }}">
  <div class="wtw-over-head"><span class="wtw-head">{{ icon_queue }}<span>Also waiting</span></span>{% if rest > 0 %}<span class="wtw-sub">and {{ rest }} more not shown</span>{% endif %}</div>
  <div class="wtw-over-grid">
  {% for i in cw offset:6 limit:6 %}
    <div class="wtw-over-item">
      <div class="wtw-over-txt">
        <span class="wtw-name">{% if i.kind == "movie" %}{{ icon_film }}{% else %}{{ icon_tv }}{% endif %}<span>{{ i.title }}</span></span>
        <span class="wtw-sub">{% if i.episode %}S{{ i.episode.season }}E{{ i.episode.number }} · {% endif %}{% if i.state == "in_progress" and i.remaining_min %}{% if i.remaining_min >= 60 %}{{ i.remaining_min | divided_by: 60 }}h {{ i.remaining_min | modulo: 60 }}m{% else %}{{ i.remaining_min }}m{% endif %} left{% else %}{% assign m = i.duration_min %}{% if m >= 60 %}{{ m | divided_by: 60 }}h {{ m | modulo: 60 }}m{% else %}{{ m }}m{% endif %} · {% if i.state == "new" %}new{% else %}next{% endif %}{% endif %}</span>
      </div>
    </div>
  {% endfor %}
  </div>
</div>
{% endif %}
{% endif %}

{% if air_n > 0 or rel_n > 0 %}
{% assign air_cols = 1 %}{% if air_n > 4 or cw_n > 6 and air_n > 2 %}{% assign air_cols = 2 %}{% endif %}
{% assign air_shown = air_n %}{% if air_shown > 8 %}{% assign air_shown = 8 %}{% endif %}
{% assign air_rows = air_shown | plus: air_cols | minus: 1 | divided_by: air_cols %}
{% assign rel_rows = rel_n %}{% if rel_rows > 3 %}{% assign rel_rows = 3 %}{% endif %}
{% assign rows = air_rows %}{% if rel_rows > rows %}{% assign rows = rel_rows %}{% endif %}{% if rows < 2 %}{% assign rows = 2 %}{% endif %}
<div class="wtw-band">
  {% if air_n > 0 %}
  <div class="wtw-col" style="flex:{% if air_cols == 2 %}5{% else %}3{% endif %}">
    <div><span class="wtw-head">{{ icon_airing }}<span>Airing today</span>{% if airing.stale %}<span class="label label--outline">stale</span>{% endif %}</span></div>
    <div class="wtw-list" style="grid-template-columns:repeat({{ air_cols }}, minmax(0, 1fr));grid-template-rows:repeat({{ rows }}, minmax(0, 1fr))">
    {% for a in air limit:8 %}
      <div class="wtw-row">
        <span class="wtw-rowposter">{% if a.poster %}<img src="{{ a.poster }}" alt="">{% endif %}{% if a.grabbed %}<span class="ok">{{ icon_check }}</span>{% endif %}</span>
        {% assign slen = a.series | size %}
        <span class="t{% if slen > 30 %} t--long{% endif %}">{{ a.series }}{% if a.milestone %}<span class="wtw-milestone">{{ a.milestone | replace: "_", " " }}</span>{% endif %}</span>
        <span class="m">S{{ a.season }}E{{ a.number }}{% if a.number_end %}–{{ a.number_end }}{% endif %} · {{ a.runtime_min }}m{% unless a.aired %}<br>airs {{ a.air_time | date: "%-I:%M %p" }}{% endunless %}</span>
      </div>
    {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if rel_n > 0 %}
  <div class="wtw-col" style="flex:2">
    <div><span class="wtw-head">{{ icon_releasing }}<span>Releasing today</span>{% if releasing_today.stale %}<span class="label label--outline">stale</span>{% endif %}</span></div>
    <div class="wtw-list" style="grid-template-columns:minmax(0, 1fr);grid-template-rows:repeat({{ rows }}, minmax(0, 1fr))">
    {% for r in rel limit:3 %}
      <div class="wtw-row">
        <span class="wtw-rowposter">{% if r.poster %}<img src="{{ r.poster }}" alt="">{% endif %}{% if r.grabbed %}<span class="ok">{{ icon_check }}</span>{% endif %}</span>
        {% assign rlen = r.title | size %}
        <span class="t{% if rlen > 30 %} t--long{% endif %}">{{ r.title }}<span class="m2">{% if r.kind == "theatrical" %}in theaters{% else %}digital{% endif %} · {% assign m = r.runtime_min %}{% if m >= 60 %}{{ m | divided_by: 60 }}h {{ m | modulo: 60 }}m{% else %}{{ m }}m{% endif %}</span></span>
      </div>
    {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
{% endif %}
{% endif %}
</div>
<div class="title_bar">
  <span class="title">What to Watch</span>
  <span class="instance">updated {{ updated_at | date: "%-I:%M %p" }}</span>
</div>
</div>
