{%- comment -%}
Calendar, full screen. The day's data comes from shared.liquid.
The layout (OG and X alike): the countdown hero and Next on the left, the rest of the day on the right.
The X shows more attendee names and description lines in the hero; the agenda fills whatever height there is.
A script at the end moves Next to the right when it doesn't fit, and trims the agenda.
On the X, when the agenda would fill less than half its column, the script switches to a focus view instead:
Now and Next at full width, the rest of the day on one Later line.
{%- endcomment -%}
{%- if keep_n == 0 and synced_today -%}<script>window.TRMNL_SKIP_DISPLAY = true</script>{%- endif -%}
<style>
  /* A full-width header (date and all-day events), then the two columns. */
  .cal-page { align-items: stretch !important; justify-content: flex-start !important; gap: 12px; padding: 6px 0 12px; }
  .cal { flex: 1; min-height: 0; display: flex; }
  .cal-title, .cal-pill, .cal-big, .cal-unit, .cal-more, .cal-t { font-family: var(--title-font-family); }
  .cal-meta, .cal-desc, .cal-date, .cal-ad, .cal-sub { font-family: var(--description-font-family); }

  .cal-hero { flex: 0 0 56%; min-width: 0; min-height: 0; display: flex; flex-direction: column; padding-right: 18px; }
  .cal-side { flex: 1; min-width: 0; display: flex; flex-direction: column; border-left: 3px solid #000; padding-left: 16px; }

  .cal-top { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .cal-top .cal-pill--solid { margin-left: auto; }
  .cal-date { font-size: 19px; font-weight: 700; }
  .cal-ad { font-size: 14px; border: 2px solid #000; border-radius: 6px; padding: 0 7px 1px; }

  /* The countdown carries the hero: time left in Now, or free time until Next. */
  .cal-count { display: flex; align-items: baseline; gap: 10px; }
  .cal-big { font-size: 84px; font-weight: 700; line-height: .9; letter-spacing: -.03em; }
  .cal-unit { font-size: 26px; font-weight: 700; }
  .cal-sub { font-size: 24px; font-weight: 700; margin-top: 4px; font-family: var(--title-font-family); }
  .cal-hero .cal-title { font-size: 26px; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 14px; }
  .cal-hero .cal-meta { font-size: 16px; }
  .cal-hero .cal-desc { font-size: 15px; }
  .cal-hero .cal-lane + .cal-lane { border-top: 2px solid #000; margin-top: 8px; padding-top: 4px; }
  .cal-hero .cal-lane + .cal-lane .cal-title { margin-top: 0; }
  .cal-hero--conflict .cal-title { font-size: 21px; -webkit-line-clamp: 1; margin-top: 4px; }

  .cal-title { font-size: 17px; font-weight: 700; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal-line { display: flex; align-items: center; gap: 6px; min-width: 0; margin-top: 3px; }
  .cal-meta { font-size: 14px; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal-desc { font-size: 14px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 6px; }
  .cal-pill { flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border: 2px solid #000; border-radius: 5px; padding: 0 5px 1px; line-height: 1.35; }
  .cal-pill--solid { background: #000; color: #fff; }

  /* Next: a bordered block at the top of the side column. */
  .cal-hero { overflow: hidden; }
  .cal-next { border: 3px solid #000; border-radius: 8px; padding: 6px 10px 8px; margin-top: auto; flex-shrink: 0; }
  .cal-hero .cal-next { margin-top: auto; }
  .cal-hero > .cal-lane:last-of-type, .cal-hero > .cal-sub { margin-bottom: 14px; }
  .cal-side > .cal-next { margin: 0 0 8px; }
  .cal-next .cal-title { font-size: 20px; margin-top: 4px; }
  .cal-next .cal-lane + .cal-lane { border-top: 2px solid #000; margin-top: 6px; padding-top: 4px; }

  .cal-list { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .cal-list > .cal-item:first-child { padding-top: 0; }
  .cal-item { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 8px; align-items: baseline; border-bottom: 1px solid #000; padding: 4px 0 5px; flex-shrink: 0; }
  .cal-t { font-size: 14px; font-weight: 700; text-align: right; }
  .cal-item .cal-line { margin-top: 0; }
  .cal-item .cal-title { flex: 0 1 auto; font-size: 16px; }
  .cal-hatch { border-radius: 5px; background: repeating-linear-gradient(-45deg, #000 0 1px, #fff 1px 7px); padding: 2px; display: flex; }
  .cal-hatch span { background: #fff; border: 2px solid #000; border-radius: 4px; padding: 0 6px 1px; font-family: var(--title-font-family); font-weight: 700; font-size: 14px; }
  .cal-more { flex-shrink: 0; font-size: 15px; font-weight: 700; padding-top: 5px; }

  /* The X by default; the OG (1- and 2-bit, per ADR-0005) gets fewer names and description lines. */
  .cal-names { margin-top: 3px; }
  .cal-names.cal-x { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .cal-og { display: none; }
  .cal-hero .cal-desc { -webkit-line-clamp: 8; }
  :is(.screen--1bit, .screen--2bit) .cal-x { display: none; }
  :is(.screen--1bit, .screen--2bit) .cal-og { display: revert; }
  :is(.screen--1bit, .screen--2bit) .cal-hero .cal-desc { -webkit-line-clamp: 3; }

  /* The X: same layout, larger type and more air. Sizes are CSS px at the X's 1.8 scale (about 1040×780). */
  .screen:not(.screen--1bit, .screen--2bit) .cal-page { gap: 20px; padding: 10px 0 18px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-date { font-size: 28px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-ad { font-size: 19px; border-radius: 8px; padding: 1px 10px 2px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero { flex-basis: 54%; padding-right: 28px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-side { padding-left: 26px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-big { font-size: 136px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-unit { font-size: 38px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-sub { font-size: 34px; margin-top: 8px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-pill { font-size: 15px; border-radius: 7px; padding: 1px 8px 2px; gap: 6px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-line { gap: 10px; margin-top: 6px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-meta { font-size: 20px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero .cal-title { font-size: 40px; margin-top: 26px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero .cal-meta { font-size: 22px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero .cal-desc { font-size: 21px; margin-top: 12px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-names { margin-top: 8px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero--conflict .cal-title { font-size: 30px; margin-top: 10px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero .cal-lane + .cal-lane { margin-top: 14px; padding-top: 10px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-next { border-radius: 12px; padding: 12px 16px 14px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hero > .cal-lane:last-of-type, .screen:not(.screen--1bit, .screen--2bit) .cal-hero > .cal-sub { margin-bottom: 24px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-side > .cal-next { margin-bottom: 14px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-next .cal-title { font-size: 30px; margin-top: 8px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-next .cal-lane + .cal-lane { margin-top: 10px; padding-top: 8px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-item { grid-template-columns: 76px minmax(0, 1fr); gap: 14px; padding: 11px 0 12px; border-bottom-width: 2px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-t { font-size: 22px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-item .cal-title { font-size: 26px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-item .cal-meta { font-size: 18px; margin-top: 3px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-item .cal-lane + .cal-lane { margin-top: 8px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hatch { border-radius: 8px; padding: 3px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-hatch span { font-size: 20px; border-radius: 6px; padding: 1px 10px 2px; }
  .screen:not(.screen--1bit, .screen--2bit) .cal-more { font-size: 21px; padding-top: 10px; }

  /* The focus view (the X only, when the agenda would be mostly empty; see fit()): one column, Now and Next at full width, the rest on one Later line. */
  .cal-later { display: none; }
  .cal.cal--focus { flex-direction: column; }
  .cal--focus > .cal-hero { flex: 1; padding-right: 0; }
  .cal--focus > .cal-side { display: none; }
  .cal--focus > .cal-later { display: flex; align-items: center; gap: 14px; border-top: 3px solid #000; margin-top: 22px; padding-top: 14px; }
  .cal--focus > .cal-later .cal-meta { font-size: 24px; }
  .cal.cal--focus .cal-big { font-size: 190px; }
  .cal.cal--focus .cal-unit { font-size: 48px; }
  .cal--focus > .cal-hero:not(.cal-hero--conflict) > .cal-lane > .cal-title { font-size: 52px; }
  .cal--focus > .cal-hero > .cal-lane .cal-desc { font-size: 24px; }
  .cal--focus > .cal-hero > .cal-next .cal-title { font-size: 36px; }
</style>


<div class="view view--full">
<div class="layout layout--col cal-page">
  <div class="cal-top">
      <span class="cal-date">{{ now_s | plus: off | date: "%A, %b %-d" }}</span>
      {%- for k in allday -%}{%- if k == "" -%}{%- continue -%}{%- endif -%}{%- assign i = k | plus: 0 -%}<span class="cal-ad">{{ evs[i].title }}</span>{%- endfor -%}
      {%- if synced_at == blank -%}<span class="cal-pill cal-pill--solid">{{ icon_alert }} Not synced yet</span>
      {%- elsif synced_today == false -%}<span class="cal-pill cal-pill--solid">{{ icon_alert }} Last sync {{ sync_s | plus: off | date: "%a %-I:%M" }}</span>{%- endif -%}
    </div>
  <div class="cal">
  <div class="cal-hero{% if now_ci != -1 %}{% assign ids = clusters[now_ci] | split: "," %}{% assign n_ids = ids | size %}{% if n_ids > 1 %} cal-hero--conflict{% endif %}{% endif %}">
  {%- if now_ci != -1 -%}
    {%- assign p = cl_spans[now_ci] | split: "-" -%}{%- assign left = p[1] | plus: 0 | minus: now_s | divided_by: 60 -%}
    <div class="cal-count">
      <span class="cal-big">{% if left >= 60 %}{{ left | divided_by: 60 }}h {{ left | modulo: 60 }}m{% else %}{{ left }}m{% endif %}</span><span class="cal-unit">left</span>
      {%- if n_ids > 1 -%}<span class="cal-pill cal-pill--solid" style="align-self:center">{{ icon_alert }} Conflict</span>{%- endif -%}
    </div>
    {%- for k in ids -%}{%- assign i = k | plus: 0 -%}{%- assign e = evs[i] -%}
      {%- assign s = e.start | date: "%s" | plus: 0 -%}{%- assign en = e.end | date: "%s" | plus: 0 -%}
      <div class="cal-lane">
        <div class="cal-title">{{ e.title }}</div>
        <div class="cal-line">
          {%- assign rp = e.reply | downcase -%}{%- if rp == "pending" -%}<span class="cal-pill cal-pill--solid">Reply?</span>{%- elsif rp == "tentative" -%}<span class="cal-pill">maybe</span>{%- endif -%}
          <span class="cal-pill">{{ e.calendar }}</span>
          <span class="cal-meta">{{ s | plus: off | date: "%-I:%M" }}–{{ en | plus: off | date: "%-I:%M %p" }}</span>
        </div>
        {%- assign a_n = 0 -%}{%- if e.attendees != blank -%}{%- assign names = e.attendees | split: ", " -%}{%- assign a_n = names | size -%}{%- endif -%}
        {%- if a_n > 0 -%}
          <div class="cal-meta cal-names cal-x">{% for a in names limit: 10 %}{{ a | split: "@" | first }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% if a_n > 10 %} +{{ a_n | minus: 10 }}{% endif %}</div>
          <div class="cal-meta cal-names cal-og">{% for a in names limit: 3 %}{{ a | split: "@" | first }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% if a_n > 3 %} +{{ a_n | minus: 3 }}{% endif %}</div>
        {%- endif -%}
        {%- if n_ids == 1 -%}
          {%- assign lines = e.description | newline_to_br | split: "<br />" -%}{%- assign d = "" -%}
          {%- for l in lines -%}{%- assign l = l | strip -%}
            {%- if l contains "zoom.us" or l contains "meet.google" or l contains "teams.microsoft" or l contains "Join " or l contains "──" or l contains "Meeting ID" -%}{%- break -%}{%- endif -%}
            {%- if l != "" -%}{%- assign d = d | append: l | append: " " -%}{%- endif -%}
          {%- endfor -%}
          {%- if d != "" -%}<div class="cal-desc">{{ d | strip }}</div>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- elsif next_ci != -1 -%}
    {%- assign p = cl_spans[next_ci] | split: "-" -%}{%- assign next_s = p[0] | plus: 0 -%}{%- assign gap = next_s | minus: now_s | divided_by: 60 -%}
    {%- comment -%} Within 15 minutes of Next the countdown reads "starts in"; before that, time until it. {%- endcomment -%}
    {%- if gap < 15 -%}
    <div class="cal-count"><span class="cal-unit">starts in</span><span class="cal-big">{{ gap }}m</span></div>
    {%- else -%}
    <div class="cal-count"><span class="cal-big">{% if gap >= 60 %}{{ gap | divided_by: 60 }}h {{ gap | modulo: 60 }}m{% else %}{{ gap }}m{% endif %}</span></div>
    <div class="cal-sub">until next meeting</div>
    {%- endif -%}
  {%- else -%}
    <div class="cal-count"><span class="cal-unit" style="font-size:40px">Nothing left today</span></div>
  {%- endif -%}
  {%- if next_ci != -1 -%}
    {%- assign ids = clusters[next_ci] | split: "," -%}{%- assign n_ids = ids | size -%}
    {%- assign p = cl_spans[next_ci] | split: "-" -%}{%- assign in_m = p[0] | plus: 0 | minus: now_s | divided_by: 60 -%}
    <div class="cal-next">
      <div class="cal-line" style="margin-top:0">
        <span class="cal-pill cal-pill--solid">Next</span>
        <span class="cal-meta" style="font-weight:700">in {% if in_m >= 60 %}{{ in_m | divided_by: 60 }}h {% endif %}{{ in_m | modulo: 60 }}m</span>
        {%- if n_ids > 1 -%}<span class="cal-pill cal-pill--solid" style="margin-left:auto">{{ icon_alert }} Conflict</span>{%- endif -%}
      </div>
      {%- for k in ids -%}{%- assign i = k | plus: 0 -%}{%- assign e = evs[i] -%}
        {%- assign s = e.start | date: "%s" | plus: 0 -%}{%- assign en = e.end | date: "%s" | plus: 0 -%}
        <div class="cal-lane">
          <div class="cal-title">{{ e.title }}</div>
          <div class="cal-line">
            {%- assign rp = e.reply | downcase -%}{%- if rp == "pending" -%}<span class="cal-pill cal-pill--solid">Reply?</span>{%- elsif rp == "tentative" -%}<span class="cal-pill">maybe</span>{%- endif -%}
            <span class="cal-pill">{{ e.calendar }}</span>
            <span class="cal-meta">{{ s | plus: off | date: "%-I:%M" }}–{{ en | plus: off | date: "%-I:%M" }}</span>
          </div>
          {%- if e.attendees != blank -%}{%- assign names = e.attendees | split: ", " -%}{%- assign a_n = names | size -%}
          <div class="cal-meta cal-x" style="margin-top:4px">{% for a in names limit: 3 %}{{ a | split: "@" | first }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% if a_n > 3 %} +{{ a_n | minus: 3 }}{% endif %}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  </div>

  <div class="cal-side">

    <div class="cal-list">
    {%- for r in rest -%}{%- if r == "" -%}{%- continue -%}{%- endif -%}
      {%- assign p = r | split: "|" -%}{%- assign r_s = p[0] | plus: 0 -%}
      <div class="cal-item" data-kind="{{ p[1] }}">
        <span class="cal-t">{{ r_s | plus: off | date: "%-I:%M" }}</span>
      {%- if p[1] == "F" -%}
        {%- assign gap = p[2] | plus: 0 | minus: r_s | divided_by: 60 -%}
        <div class="cal-hatch"><span>Free · {% if gap >= 60 %}{{ gap | divided_by: 60 }}h {% endif %}{% assign mm = gap | modulo: 60 %}{% if mm > 0 %}{{ mm }}m{% endif %}</span></div>
      {%- else -%}
        {%- assign ci = p[2] | plus: 0 -%}{%- assign ids = clusters[ci] | split: "," -%}{%- assign n_ids = ids | size -%}
        <div>
        {%- for k in ids -%}{%- assign i = k | plus: 0 -%}{%- assign e = evs[i] -%}
          <div class="cal-lane">
          <div class="cal-line">
            {%- if n_ids > 1 and forloop.first -%}<span class="cal-pill cal-pill--solid">{{ icon_alert }}</span>{%- endif -%}
            <span class="cal-title">{{ e.title }}</span>
            {%- assign rp = e.reply | downcase -%}{%- if rp == "pending" -%}<span class="cal-pill cal-pill--solid">Reply?</span>{%- elsif rp == "tentative" -%}<span class="cal-pill">maybe</span>{%- endif -%}
            <span class="cal-pill">{{ e.calendar }}</span>
          </div>
          {%- comment -%} The X has room for each event's times, people and the first line of its notes. {%- endcomment -%}
          {%- assign s = e.start | date: "%s" | plus: 0 -%}{%- assign en = e.end | date: "%s" | plus: 0 -%}{%- assign a_n = 0 -%}
          {%- if e.attendees != blank -%}{%- assign names = e.attendees | split: ", " -%}{%- assign a_n = names | size -%}{%- endif -%}
          <div class="cal-meta cal-x">{{ s | plus: off | date: "%-I:%M" }}–{{ en | plus: off | date: "%-I:%M" }}{% if a_n > 0 %} · {% for a in names limit: 4 %}{{ a | split: "@" | first }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% if a_n > 4 %} +{{ a_n | minus: 4 }}{% endif %}{% endif %}</div>
          {%- assign lines = e.description | newline_to_br | split: "<br />" -%}{%- assign d = "" -%}
          {%- for l in lines -%}{%- assign l = l | strip -%}
            {%- if l contains "zoom.us" or l contains "meet.google" or l contains "teams.microsoft" or l contains "Join " or l contains "──" or l contains "Meeting ID" -%}{%- break -%}{%- endif -%}
            {%- if l != "" -%}{%- assign d = l -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- if d != "" -%}<div class="cal-meta cal-x">{{ d }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
        </div>
      {%- endif -%}
      </div>
    {%- endfor -%}
    </div>
    <div class="cal-more" hidden></div>
  </div>
  {%- comment -%}
  The focus view's one line for the rest of the day (see fit()).
  shortcut: a conflict shows only its first title; list every lane if that turns out to hide things.
  {%- endcomment -%}
  {%- capture later -%}{%- for r in rest -%}{%- assign p = r | split: "|" -%}{%- if p[1] != "C" -%}{%- continue -%}{%- endif -%}
    {%- assign ci = p[2] | plus: 0 -%}{%- assign ids = clusters[ci] | split: "," -%}{%- assign i = ids[0] | plus: 0 -%}
    {{- " · " -}}<b>{{ p[0] | plus: off | date: "%-I:%M" }}</b> {{ evs[i].title }}
  {%- endfor -%}{%- endcapture -%}
  {%- if later != "" -%}<div class="cal-later"><span class="cal-pill cal-pill--solid">Later</span><span class="cal-meta">{{ later | remove_first: " · " }}</span></div>{%- endif -%}
</div>
</div>
<script>
  /* Next stays under the hero when it fits, else moves to the top of the side column.
     Then agenda rows that don't fit are dropped, and the dropped events are counted. */
  function fit() {
    var box = document.querySelector(".cal"), next = document.querySelector(".cal-hero .cal-next"),
        side = document.querySelector(".cal-side"), list = document.querySelector(".cal-list"), more = document.querySelector(".cal-more");
    var bottom = box.getBoundingClientRect().bottom, desc = document.querySelector(".cal-hero .cal-desc");
    var nextOver = function () { return next && next.getBoundingClientRect().bottom > bottom + 1; };
    // Shorten the hero's notes before giving up the room under the hero: on the X down to none, on the OG never below 3 lines.
    var og = !!document.querySelector(".screen--1bit, .screen--2bit"), least = og ? 3 : 0;
    var reset = function () { if (desc) { desc.style.webkitLineClamp = ""; desc.hidden = false; } };
    var shorten = function () {
      var clamp = desc ? parseInt(getComputedStyle(desc).webkitLineClamp, 10) || 0 : 0;
      while (nextOver() && clamp > least) { --clamp; if (clamp) desc.style.webkitLineClamp = clamp; else desc.hidden = true; }
      return !nextOver();
    };
    // On the X, an agenda that would fill less than half its column gives the screen to Now and Next instead.
    var last = list.lastElementChild, used = last ? last.getBoundingClientRect().bottom - list.getBoundingClientRect().top : 0;
    if (!og && used < list.clientHeight / 2) {
      box.classList.add("cal--focus");
      if (shorten()) return;
      box.classList.remove("cal--focus"); reset();
    }
    if (!shorten()) { reset(); side.insertBefore(next, side.firstChild); }
    var over = function () { var last = list.lastElementChild; return last && last.getBoundingClientRect().bottom > list.getBoundingClientRect().bottom + 1; };
    if (!over()) return;
    more.hidden = false; more.textContent = "+ more";
    var hidden = 0;
    while (list.lastElementChild && over()) {
      if (list.lastElementChild.getAttribute("data-kind") === "C") hidden++;
      list.removeChild(list.lastElementChild);
    }
    if (hidden) more.textContent = "+" + hidden + " more today"; else more.hidden = true;
  }
  // Measure once fonts and layout have settled.
  if (document.readyState === "complete") fit(); else window.addEventListener("load", fit);
</script>
<div class="title_bar">
  <span class="title">Calendar</span>
  <span class="instance">{% if synced_at != blank %}synced {{ sync_s | plus: off | date: "%-I:%M %p" }}{% endif %}</span>
</div>
</div>
